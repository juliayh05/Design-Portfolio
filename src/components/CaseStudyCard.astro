---
interface Props {
    href: string;
    logoSrc: string;
    companyName: string;
    headline: string;
    tags: string[];
    ctaLabel: string;
    previewSrc: string;
    logoSize?: number;
}

const { href, logoSrc, companyName, headline, tags, ctaLabel, previewSrc, logoSize = 24 } = Astro.props;
---

<a href={href} class="case-study-card fade-in-on-scroll">
	<div class="case-study-card__left">
		<div class="case-study-card__company">
			<img src={logoSrc} alt="" class="case-study-card__logo" width={logoSize} height={logoSize} />
		</div>
		<h3 class="case-study-card__headline">{headline}</h3>
		<div class="case-study-card__tags">
			{tags.map((tag) => (
				<span class="case-study-card__tag">{tag}</span>
			))}
		</div>
		<span class="case-study-card__cta">
			{ctaLabel}
			<span class="case-study-card__cta-arrow" aria-hidden="true">↗</span>
		</span>
	</div>
	<div class="case-study-card__right">
		<img src={previewSrc} alt="" class="case-study-card__preview" />
	</div>
</a>

<style>
	.case-study-card {
    display: flex;
    align-items: center;
    gap: 32px;
    width: 100%;
    max-width: 100%;
	margin: 0 auto;
	padding: 48px 64px;
    background-color: #fff;
	border: 1px solid #EDEDED;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    border-radius: 24px;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition:
		box-shadow 200ms ease-out,
		transform 200ms ease-out;
}

	.case-study-card:hover {
		box-shadow: 0 12px 40px rgba(52, 108, 228, 0.22);
		transform: translateY(-4px);
	}

	.case-study-card:hover .case-study-card__preview {
		transform: scale(1.03);
	}

	.case-study-card:hover .case-study-card__cta {
    background-color: #4483F0;
    color: #ffffff;
    border-color: transparent;
    box-shadow: 0 0 20px rgba(68, 131, 240, 0.3);
    transform: translateY(-2px);
}

	.case-study-card__left {
		display: flex;
		flex: 0 0 55%;
		flex-direction: column;
		justify-content: center;
		gap: 16px;
		min-width: 0;
	}

	.case-study-card__company {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.case-study-card__logo {
    	height: 40px;
    	width: auto;
    	object-fit: contain;
	}

	.case-study-card__company-name {
		font-family: 'Work Sans', sans-serif;
		font-size: 20px;
		font-weight: 400;
		color: #000;
	}

	.case-study-card__headline {
		margin: 0;
		font-family: 'Work Sans', sans-serif;
		font-size: 28px;
		font-weight: 600;
		line-height: 1.2;
		color: #000;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.case-study-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.case-study-card__tag {
    padding: 8px 16px;
    background-color: #F5F5F5;
    border-radius: 9999px;
    font-family: 'Work Sans', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #4A4A4A;
}

	.case-study-card__cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		align-self: flex-start;
		margin-top: 24px;
		padding: 8px 18px;
		background-color: #E4F0FF;
		border-radius: 9999px;
		font-family: 'Work Sans', sans-serif;
		font-size: 16px;
		font-weight: 500;
		color: #4483F0;
		border: 2px solid transparent;
		transition:
			background-color 200ms ease-out,
			color 200ms ease-out,
			border-color 200ms ease-out,
			box-shadow 200ms ease-out,
			transform 200ms ease-out;
	}

	.case-study-card__cta-arrow {
		font-size: 16px;
		line-height: 1;
	}

	.case-study-card__right {
		display: flex;
		flex: 0 0 45%;
		justify-content: flex-end;
		align-items: center;
		min-width: 0;
	}

	.case-study-card__preview {
		max-height: 320px;
		width: auto;
		height: auto;
		object-fit: contain;
		transition: transform 200ms ease-out;
	}

	@media (max-width: 768px) {
		.case-study-card {
			flex-direction: column;
			padding: 24px 20px;
			gap: 24px;
		}

		.case-study-card__left,
		.case-study-card__right {
			flex: 1 1 auto;
			width: 100%;
		}

		.case-study-card__right {
			order: -1;
			justify-content: center;
		}

		.case-study-card__preview {
			max-height: 280px;
			width: 100%;
		}

		.case-study-card__headline {
			font-size: 22px;
		}

		.case-study-card__left {
			gap: 16px;
		}
	}
</style>
