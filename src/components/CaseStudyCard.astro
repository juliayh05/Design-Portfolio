---
interface Props {
	href: string;
	title: string;
	description: string;
	previewSrc: string;
	previewAlt?: string;
	icon?: string;
	iconLabel?: string;
	dark?: boolean;
}

const { href, title, description, previewSrc, previewAlt = '', icon, iconLabel = title.charAt(0), dark = false } = Astro.props;
---

<a href={href} class:list={["case-study-card", "fade-in-on-scroll", dark && "case-study-card--dark"]}>
	<div class="case-study-card__frame">
		<img src={previewSrc} alt={previewAlt} class="case-study-card__preview" />
	</div>
	<div class="case-study-card__meta">
		<div class="case-study-card__title-row">
			{icon ? (
				<img src={icon} alt="" class="case-study-card__icon" />
			) : (
				<span class="case-study-card__icon case-study-card__icon--fallback" aria-hidden="true">{iconLabel}</span>
			)}
			<h3 class="case-study-card__title">{title}</h3>
		</div>
		<p class="case-study-card__description">{description}</p>
	</div>
</a>

<style>
	.case-study-card {
		display: flex;
		flex-direction: column;
		width: 100%;
		text-decoration: none;
		color: inherit;
		cursor: pointer;
	}

	.case-study-card__frame {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		min-height: 320px;
		padding: 40px;
		background-color: #fff;
		border: 1px solid #EDEDED;
		border-radius: 28px;
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
		overflow: hidden;
		transition:
			box-shadow 200ms ease-out,
			transform 200ms ease-out,
			border-color 200ms ease-out;
	}

	.case-study-card:hover .case-study-card__frame {
		box-shadow: 0 16px 40px rgba(52, 108, 228, 0.16);
		border-color: #E4F0FF;
		transform: translateY(-4px);
	}

	.case-study-card--dark .case-study-card__frame {
		background-color: #141414;
		border-color: #141414;
	}

	.case-study-card--dark:hover .case-study-card__frame {
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
		border-color: #2a2a2a;
		transform: translateY(-4px);
	}

	.case-study-card:hover .case-study-card__preview {
		transform: scale(1.03);
	}

	.case-study-card__preview {
		max-width: 100%;
		max-height: 340px;
		width: auto;
		height: auto;
		object-fit: contain;
		transition: transform 200ms ease-out;
	}

	.case-study-card__meta {
		margin-top: 20px;
	}

	.case-study-card__title-row {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.case-study-card__icon {
		flex: 0 0 auto;
		width: 32px;
		height: 32px;
		border-radius: 9px;
		object-fit: cover;
	}

	.case-study-card__icon--fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #F5F5F5;
		color: #4A4A4A;
		font-family: 'Gabarito', sans-serif;
		font-size: 15px;
		font-weight: 600;
	}

	.case-study-card__title {
		margin: 0;
		font-family: 'Gabarito', sans-serif;
		font-size: 21px;
		font-weight: 700;
		line-height: 1.25;
		color: #1a1a1a;
	}

	.case-study-card__description {
		margin: 6px 0 0;
		font-family: 'Gabarito', sans-serif;
		font-size: 15px;
		font-weight: 400;
		line-height: 1.4;
		color: #767676;
	}

	@media (max-width: 768px) {
		.case-study-card__frame {
			min-height: 260px;
			padding: 24px;
		}

		.case-study-card__preview {
			max-height: 260px;
		}

		.case-study-card__title {
			font-size: 19px;
		}
	}
</style>
