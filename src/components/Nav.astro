---
interface Props {
	sticky?: boolean;
}

const { sticky = false } = Astro.props;
---

<nav class:list={['nav', { 'nav--sticky': sticky }]}>
	<div class="nav-inner">
		<a href="/" class="nav-logo">Julia Heo</a>
		<div class="nav-links">
			<a href="/about">About</a>
<a href="/#work">Work</a>
<a href="/#projects">Projects</a>
<a href="/#play">Play</a>
		</div>
	</div>
</nav>

<style>
	.nav {
		padding-top: 0px;
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: #F9F9F9;
	}

	.nav--sticky {
		position: sticky;
		top: 0;
		z-index: 100;
		padding: 0;
		background-color: #F9F9F9;
		border-bottom: 1px solid #e8e8e8;
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 100%;
	}

	.nav--sticky .nav-inner {
		padding: 20px 64px;
	}

	.nav-logo {
		font-family: 'Instrument Serif', serif;
		font-size: 20px;
		font-style: normal;
		font-weight: 400;
		color: #000;
		text-decoration: none;
	}

	.nav-links {
		display: flex;
		gap: 48px;
	}

	.nav-links a {
		font-family: 'Work Sans', sans-serif;
		font-size: 18px;
		font-weight: 400;
		color: #000;
		text-decoration: none;
	}

	@media (max-width: 768px) {
		.nav--sticky .nav-inner {
			padding: 16px 20px;
		}

		.nav-links {
			gap: 20px;
		}

		.nav-links a {
			font-size: 14px;
		}

		.nav-logo {
			font-size: 18px;
		}
	}

	@media (max-width: 480px) {
		.nav-links {
			gap: 12px;
		}

		.nav-links a {
			font-size: 12px;
		}

		.nav-logo {
			font-size: 16px;
		}
	}
</style>
