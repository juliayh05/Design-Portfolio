---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class="subsection">
	<h3 class="subsection-title">{title}</h3>
	<div class="subsection-body">
		<slot />
	</div>
</div>

<style>
	.subsection-title {
		margin: 0 0 8px;
		font-family: 'Inter', sans-serif;
		font-size: 22px;
		font-style: normal;
		font-weight: 420;
		line-height: 1.3;
		color: #000;
	}

	.subsection-body {
		font-family: 'Inter', sans-serif;
		font-size: 18px;
		font-weight: 400;
		line-height: 1.6;
		color: #000;
	}

	.subsection-body :global(p) {
		margin: 0;
	}
</style>
