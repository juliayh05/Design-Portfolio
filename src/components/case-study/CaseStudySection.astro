---
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="case-study-section" data-case-section>
	<h2 class="section-heading">{title}</h2>
	<div class="section-body">
		<slot />
	</div>
</section>

<style>
	.case-study-section {
		scroll-margin-top: 96px;
	}

	.case-study-section + .case-study-section {
		margin-top: 120px;
	}

	.section-heading {
		margin: 0 0 40px;
		font-family: 'Instrument Serif', serif;
		font-size: 36px;
		font-style: normal;
		font-weight: 400;
		line-height: 1.2;
		color: #000;
	}

	.section-body {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}
</style>
