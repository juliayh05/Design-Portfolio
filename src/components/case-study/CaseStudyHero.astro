---
interface Props {
	logoSrc: string;
	logoAlt?: string;
	headline: string;
	subtitle: string;
	tags: string[];
	description: string;
}

const { logoSrc, logoAlt = '', headline, subtitle, tags, description } = Astro.props;
---

<header class="case-study-hero">
	<img src={logoSrc} alt={logoAlt} class="logo" />
	<h1 class="headline">{headline}</h1>
	<p class="subtitle">{subtitle}</p>
	<div class="tags">
		{tags.map((tag) => (
			<span class="tag">{tag}</span>
		))}
	</div>
	<p class="description">{description}</p>
	<slot />
</header>

<style>
	.case-study-hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
		padding-top: 48px;
		padding-bottom: 48px;
		text-align: left;
	}

	.logo {
		height: 32px;
		width: auto;
		object-fit: contain;
	}

	.headline {
		margin: 0;
		font-family: 'Gabarito', sans-serif;
		font-size: 24px;
		font-weight: 500;
		line-height: 1.2;
		color: #1a1a1a;
	}

	.subtitle {
		margin: 0;
		font-family: 'Gabarito', sans-serif;
		font-size: 14px;
		font-weight: 400;
		line-height: 1.4;
		color: #868686;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
	}

	.tag {
		padding: 6px 12px;
		background-color: #f5f5f5;
		border-radius: 9999px;
		font-family: 'Gabarito', sans-serif;
		font-size: 14px;
		font-weight: 400;
		color: #4a4a4a;
	}

	.description {
		margin: 0;
		max-width: 640px;
		font-family: 'Gabarito', sans-serif;
		font-size: 18px;
		font-weight: 400;
		line-height: 1.5;
		color: #4a4a4a;
	}

	@media (max-width: 768px) {
		.case-study-hero {
			padding-top: 32px;
			padding-bottom: 32px;
		}

		.headline {
			font-size: 22px;
		}

		.description {
			font-size: 16px;
		}
	}
</style>