---
const pathname = Astro.url.pathname;

const navItems = [
	{ label: 'About', href: '/about', key: 'about' },
	{ label: 'Work', href: '/work', key: 'work' },
	{ label: 'Projects', href: '/projects', key: 'projects' },
];

const isActive = (key: string) => {
	if (key === 'about') {
		return pathname === '/about' || pathname.startsWith('/about/');
	}
	if (key === 'work') {
		return pathname === '/work' || pathname.startsWith('/work/');
	}
	if (key === 'projects') {
		return pathname === '/projects' || pathname.startsWith('/projects/');
	}
	return false;
};
---

<nav class="home-nav sticky top-0 z-50 w-full bg-[#FFFFFF] py-6 border-b border-[#EDEDED]">
	<div class="mx-auto flex w-full max-w-[1024px] items-center justify-between px-6">
		<!-- LEFT: home link -->
		<a href="/" class="home-nav__brand group flex items-center gap-2.5 no-underline transition-all duration-200 hover:-translate-y-0.5">
			<img
				src="/images/about/portraitdrawn1.png"
				alt="Julia Heo"
				class="h-8 w-8 rounded-full object-cover"
			/>
			<span class="font-sans text-base font-normal text-[#1a1a1a]">Julia</span>
		</a>

		<!-- CENTER: nav pill group -->
		<div class="home-nav__pills flex items-center gap-2">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class:list={[
							'rounded-full px-5 py-2 font-sans text-base font-normal no-underline transition-all duration-200',
							isActive(item.key)
								? 'text-[#4483F0] font-medium'
								: 'text-[#1a1a1a] hover:text-[#4483F0] hover:-translate-y-0.5',
						]}
					>
						{item.label}
					</a>
				))
			}
		</div>

		<!-- RIGHT: social/contact icons -->
<div class="home-nav__icons flex items-center gap-2">
    <a href="https://www.linkedin.com/in/juliaheo" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="LinkedIn">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
    </svg>
</a>
    <a href="mailto:juliaheo@berkeley.edu" class="icon-btn" aria-label="Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
    </a>
    <a href="https://drive.google.com/file/d/1FLGCJYQ_BXeyMN5UhLtTjZVK5Tk8t5a7/view?usp=sharing" class="icon-btn" aria-label="Resume">
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
            <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
            <path d="M10 9H8"/>
            <path d="M16 13H8"/>
            <path d="M16 17H8"/>
        </svg>
	</a>
</div>
	</div>
</nav>

<style>
	.icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background-color: transparent;
    cursor: pointer;
    padding: 0;
    color: #1a1a1a;
    text-decoration: none;
    transition: color 200ms ease, transform 200ms ease;
}


.icon-btn:hover {
    color: #4483F0;
    transform: translateY(-1px);
}

	

	@media (max-width: 768px) {
		.home-nav {
			padding: 16px 20px;
		}

		.home-nav__pills {
			gap: 4px;
		}

		.home-nav__pills a {
			padding: 6px 12px;
			font-size: 14px;
		}

		.home-nav__brand span {
			font-size: 18px;
		}

		.home-nav__brand img {
			width: 32px;
			height: 32px;
		}

		.icon-btn {
			width: 32px;
			height: 32px;
		}

		.home-nav__icons {
			gap: 8px;
		}
	}

	@media (max-width: 640px) {
		.home-nav > div {
			flex-wrap: wrap;
			justify-content: center;
			gap: 16px;
		}

		.home-nav__brand {
			flex: 1 1 auto;
		}

		.home-nav__pills {
			order: 3;
			flex: 1 1 100%;
			justify-content: center;
			flex-wrap: wrap;
		}

		.home-nav__icons {
			flex: 0 0 auto;
		}
	}
</style>

