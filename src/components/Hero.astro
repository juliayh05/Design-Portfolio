---
const footnotes = [
	{
		id: 'julia',
		word: 'Julia Heo',
		line1: 'Currently a senior at UC Berkeley studying',
		line2: 'Cognitive Science, Education, & Design.',
	},
	{
		id: 'designer',
		word: 'product designer',
		line1: '4 consumer startups, and counting.',
		line2: 'Built for fast-paced environments.',
	},
	{
		id: 'pixels',
		word: 'pixels',
		line1: 'Spacing, typography, motion, color, etc.',
		line2: 'Small choices, big feel.',
	},
	{
		id: 'patterns',
		word: 'patterns',
		line1: 'Design systems, reusable components, and',
		line2: 'the logic that scales craft across a product.',
	},
	{
		id: 'people',
		word: 'people',
		line1: 'I design with how people actually think,',
		line2: 'feel, and get frustrated.',
	},
];
---

<div class="page">
	<nav class="nav">
		<a href="/" class="nav-logo">Julia Heo</a>
		<div class="nav-links">
			<a href="#about">About</a>
			<a href="#work">Work</a>
			<a href="#projects">Projects</a>
			<a href="#play">Play</a>
		</div>
	</nav>

	<section class="hero">
		<div class="hero-content">
			<p class="hero-hint">psst! hover the blue for footnotes!</p>

			<p class="headline" id="headline">
				<span class="phrase" data-footnote-line1={footnotes[0].line1} data-footnote-line2={footnotes[0].line2}>
					<span class="phrase-word">{footnotes[0].word}</span><span class="phrase-asterisk">*</span>
				</span>
				<span class="text"> is a </span>
				<span class="phrase" data-footnote-line1={footnotes[1].line1} data-footnote-line2={footnotes[1].line2}>
					<span class="phrase-word">{footnotes[1].word}</span><span class="phrase-asterisk">*</span>
				</span>
				<span class="text"> who's passionate about the </span>
				<span class="phrase" data-footnote-line1={footnotes[2].line1} data-footnote-line2={footnotes[2].line2}>
					<span class="phrase-word">{footnotes[2].word}</span><span class="phrase-asterisk">*</span>
				</span>
				<span class="text">, the </span>
				<span class="phrase" data-footnote-line1={footnotes[3].line1} data-footnote-line2={footnotes[3].line2}>
					<span class="phrase-word">{footnotes[3].word}</span><span class="phrase-asterisk">*</span>
				</span>
				<span class="text">, and the </span>
				<span class="phrase" data-footnote-line1={footnotes[4].line1} data-footnote-line2={footnotes[4].line2}>
					<span class="phrase-word">{footnotes[4].word}</span><span class="phrase-asterisk">*</span>
				</span>
				<span class="text"> they're built for.</span>
			</p>

			<div class="footnote" id="footnote" aria-live="polite"></div>
		</div>
	</section>

	<section class="below-hero">
		<div class="tabs">
			<span class="tab tab--active">Work</span>
			<span class="tab">Projects</span>
			<span class="tab">Play</span>
		</div>

		<div class="cards">
			<div class="card"></div>
			<div class="card"></div>
		</div>
	</section>
</div>

<script>
	const headline = document.getElementById('headline');
	const footnote = document.getElementById('footnote');

	if (headline && footnote) {
		const phrases = headline.querySelectorAll('.phrase');

		phrases.forEach((phrase) => {
			phrase.addEventListener('mouseenter', () => {
				phrases.forEach((p) => p.classList.remove('is-active'));
				phrase.classList.add('is-active');
				headline.classList.add('is-hovering');
				const line1 = phrase.dataset.footnoteLine1 ?? '';
				const line2 = phrase.dataset.footnoteLine2 ?? '';
				footnote.innerHTML = `${line1}<br />${line2}`;
			});

			phrase.addEventListener('mouseleave', (e) => {
				const related = e.relatedTarget;
				if (related instanceof Element && related.closest('.phrase')) {
					return;
				}
				headline.classList.remove('is-hovering');
				phrase.classList.remove('is-active');
				footnote.innerHTML = '';
			});
		});
	}
</script>

<style>
	.page {
		min-height: 100vh;
		padding: 0 64px;
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 40px;
	}

	.nav-logo {
		font-family: 'Instrument Serif', serif;
		font-size: 20px;
		font-style: normal;
		font-weight: 400;
		color: #000;
		text-decoration: none;
	}

	.nav-links {
		display: flex;
		gap: 48px;
	}

	.nav-links a {
		font-family: 'Inter', sans-serif;
		font-size: 20px;
		font-weight: 400;
		color: #000;
		text-decoration: none;
	}

	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: 7.5vh;
	}

	.hero-content {
		width: 100%;
		max-width: 900px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero-hint {
		margin: 0 0 16px;
		font-family: 'Inter', sans-serif;
		font-size: 18px;
		color: #a8a8a8;
		text-align: center;
	}

	.headline {
		margin: 0;
		width: 100%;
		max-width: 900px;
		font-family: 'Instrument Serif', serif;
		font-size: 60px;
		font-style: normal;
		font-weight: 400;
		line-height: 1.3;
		text-align: center;
	}

	.headline .text {
		color: #000;
		transition: color 150ms ease-out;
	}

	.headline .phrase {
		color: #346ce4;
		cursor: default;
		transition: color 150ms ease-out;
	}

	.headline .phrase-word {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
		transition: text-decoration-color 150ms ease-out;
	}

	.headline.is-hovering .text,
	.headline.is-hovering .phrase:not(.is-active) {
		color: #aeaeae;
	}

	.headline.is-hovering .phrase:not(.is-active) .phrase-word {
		text-decoration-color: transparent;
	}

	.headline .phrase.is-active {
		color: #346ce4;
	}

	.headline .phrase.is-active .phrase-word {
		text-decoration-color: #346ce4;
	}

	.footnote {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: 900px;
		min-height: 80px;
		margin-top: 32px;
		font-family: 'Inter', sans-serif;
		font-size: 20px;
		line-height: 1.4;
		text-align: center;
		text-wrap: balance;
		color: #346ce4;
	}

	.below-hero {
		margin-top: 120px;
	}

	.tabs {
		display: flex;
		justify-content: center;
		gap: 40px;
	}

	.tab {
		font-family: 'Inter', sans-serif;
		font-size: 20px;
		font-weight: 400;
		color: #a8a8a8;
		cursor: default;
	}

	.tab--active {
		color: #346ce4;
	}

	.cards {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 40px;
		margin-top: 40px;
	}

	.card {
		width: 100%;
		max-width: 1000px;
		aspect-ratio: 2 / 1;
		background-color: #f0f0f0;
		border-radius: 20px;
	}
</style>
