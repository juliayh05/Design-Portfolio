---
const highlights = [
	{ text: 'product designer*', tooltip: '🧠 Senior @ UC Berkeley. I think in interfaces, systems, and how people learn. Love learning!' },
	{ text: 'builds*', tooltip: "🚀 I don't just design in Figma, I build! Prototyping with code, using AI to move faster, and I even built this portfolio in Cursor!" },
	{ text: 'pixels*', tooltip: '🔍 Obsessive about type, spacing, and motion. The details are the design.' },
	{ text: 'patterns*', tooltip: '🧩 Strong product thinking. I zoom out to systems, zoom in to decisions, and can defend both.' },
	{ text: 'problems*', tooltip: '🔥 Fast-moving environments are my favorite. I work through ambiguity by shipping, testing, and iterating' },
	{ text: 'people*', tooltip: '🤝 Design is for someone specific. I care about the users I design for and the team I design with.' },
];
---

<div class="page bg-[#FFFFFF] min-h-screen">
	<section class="hero flex flex-col items-center pt-24 pb-16 px-8 text-center">
		<div class="hero-headline hero-animate flex items-center justify-center">
			<h1 class="font-serif text-[56px] leading-tight text-[#1a1a1a]">H<i>e</i>llo! I'm Julia Heo</h1>
			<img
				src="/images/about/me.png"
				alt="Julia Heo"
				class="hero-headshot ml-4 h-[52px] w-[52px] rounded-full object-cover"
			/>
		</div>

		<div class="group/desc desc-block hero-animate mt-8 max-w-3xl">
			<p class="desc-text font-sans text-[24px] leading-[1.8] text-[#1a1a1a]">
				<span class="desc-plain">a </span>
				<span class="highlight relative inline-block cursor-pointer rounded-md bg-[#E4F0FF] px-2 py-0.5 font-medium leading-tight text-[#4483F0] transition-all duration-200">
					{highlights[0].text}
					<span class="highlight-tooltip" aria-hidden="true">{highlights[0].tooltip}</span>
				</span>
				<span class="desc-plain"> based in SF </span>
				<span class="desc-plain"> who </span>
				<span class="highlight relative inline-block cursor-pointer rounded-md bg-[#E4F0FF] px-2 py-0.5 font-medium leading-tight text-[#4483F0] transition-all duration-200">
					{highlights[1].text}
					<span class="highlight-tooltip" aria-hidden="true">{highlights[1].tooltip}</span>
				</span>
				
				<span class="desc-plain"> and is passionate about </span>
				<span class="highlight relative inline-block cursor-pointer rounded-md bg-[#E4F0FF] px-2 py-0.5 font-medium leading-tight text-[#4483F0] transition-all duration-200">
					{highlights[2].text}
					<span class="highlight-tooltip" aria-hidden="true">{highlights[2].tooltip}</span>
				</span>
				<span class="desc-plain"> </span>
				<span class="highlight relative inline-block cursor-pointer rounded-md bg-[#E4F0FF] px-2 py-0.5 font-medium leading-tight text-[#4483F0] transition-all duration-200">
					{highlights[3].text}
					<span class="highlight-tooltip" aria-hidden="true">{highlights[3].tooltip}</span>
				</span>
				<span class="desc-plain"> </span>
				<span class="highlight relative inline-block cursor-pointer rounded-md bg-[#E4F0FF] px-2 py-0.5 font-medium leading-tight text-[#4483F0] transition-all duration-200">
					{highlights[4].text}
					<span class="highlight-tooltip" aria-hidden="true">{highlights[4].tooltip}</span>
				</span>
				<span class="desc-plain"> and </span>
				<span class="highlight relative inline-block cursor-pointer rounded-md bg-[#E4F0FF] px-2 py-0.5 font-medium leading-tight text-[#4483F0] transition-all duration-200">
					{highlights[5].text}
					<span class="highlight-tooltip" aria-hidden="true">{highlights[5].tooltip}</span>
				</span>
				<span class="desc-plain"> they're designed for.</span>
			</p>
		</div>
	</section>

	<section class="below-hero">
		<div class="mini-nav-row flex items-center justify-between mb-4">
    <div
        class="tabs mini-nav flex justify-start gap-1"
        role="tablist"
        aria-label="Portfolio sections"
    >
        <button type="button" class="tab tab--active" data-tab="work" role="tab" aria-selected="true">📁 Selected Work</button>
        <button type="button" class="tab" data-tab="projects" role="tab" aria-selected="false">✨ Personal Projects</button>
        <button type="button" class="tab" data-tab="play" role="tab" aria-selected="false">🍪 Fun</button>
    </div>
    <div class="status-indicator">
    <span class="status-dot"></span>
    <span class="status-text">Currently designing NoTestudo @ <a href="https://narb.cc/" target="_blank" rel="noopener noreferrer" class="status-link-text">narb</a></span>
</div>
</div>
		<div class="tab-panels">
			<div class="tab-panel" data-tab-panel="work">
				<div class="cards">
					<slot name="work" />
				</div>
			</div>
			<div class="tab-panel" data-tab-panel="projects" hidden>
				<slot name="projects" />
			</div>
			<div class="tab-panel" data-tab-panel="play" hidden>
				<slot name="play" />
			</div>
		</div>
	</section>
</div>

<style>
	@keyframes hero-load-in {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-animate {
		animation: hero-load-in 800ms ease-out both;
	}

	.hero-headline {
		animation-delay: 0ms;
	}

	.desc-block {
		animation-delay: 100ms;
	}

	.mini-nav {
		animation-delay: 300ms;
		scroll-margin-top: 80px;
	}

	

	.highlight-tooltip {
		position: absolute;
		left: 50%;
		top: calc(100% + 8px);
		z-index: 20;
		width: 240px;
		transform: translateX(-50%);
		border-radius: 8px;
		background-color: #ffffff;
		padding: 12px;
		font-family: 'Work Sans', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 400;
		line-height: 1.4;
		color: #1a1a1a;
		text-align: left;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 200ms ease, visibility 200ms ease;
	}

	.highlight:hover .highlight-tooltip {
		opacity: 1;
		visibility: visible;
	}

	.desc-block:has(.highlight:hover) .desc-plain {
		color: #b0b0b0;
		transition: color 200ms ease;
	}

	.desc-block:has(.highlight:hover) .highlight:not(:hover) {
		background-color: transparent;
		color: #b0b0b0;
		transition:
			color 200ms ease,
			background-color 200ms ease;
	}

	.tab {
		border: none;
		background: none;
		padding: 6px 16px;
		border-radius: 9999px;
		font-family: 'Work Sans', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 400;
		color: #868686;
		cursor: pointer;
		transition: all 200ms ease;
	}

	.tab::after {
		display: none;
	}

	.tab:hover:not(.tab--active) {
		background-color: rgba(255, 255, 255, 0.5);
		color: #1a1a1a;
	}

	.tab--active {
		background-color: #EDEDED;
		color: #868686;
	}

	.status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
	padding-left: 8px;
    font-family: 'Work Sans', sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: #868686;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #22C55E;
    animation: pulse 2.0s ease-in-out infinite;
    flex-shrink: 0;
}

@keyframes pulse {
    0%, 100% {
        opacity: 1;
        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5);
    }
    50% {
        opacity: 0.8;
        box-shadow: 0 0 0 8px rgba(34, 197, 94, 0);
    }
}

	.below-hero {
		margin-top: 48px;
		padding: 0 0 80px;
	}

	.tab-panels {
		margin-top: 0;
	}

	.cards {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 40px;
}

	@media (prefers-reduced-motion: reduce) {
		.hero-animate {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 768px) {
		.hero {
			min-height: auto;
			padding: 48px 20px 32px;
		}

		.hero-headline {
			flex-direction: column;
			gap: 16px;
		}

		.hero-headline h1 {
			font-size: 40px;
		}

		.hero-headshot {
			margin-left: 0;
		}

		.desc-text {
			font-size: 22px;
		}

		.tab {
			font-size: 16px;
			padding: 8px 16px;
		}

		.below-hero {
    margin-top: 48px;
    padding: 0 0 80px;
	}

		.cards {
			gap: 24px;
		}
	}

	.status-link-text {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 200ms ease;
}

.status-link-text:hover {
    color: #4483F0;
}
</style>
