---
interface Props {
	logo: string;
	logoAlt: string;
	logoHeight?: number;
	headline: string;
	role?: string;
	timeframe?: string;
	tags: string[];
	description?: string;
}

const { logo, logoAlt, logoHeight = 48, headline, role, timeframe, tags, description } = Astro.props;

const subtitle = role ? (timeframe ? `${role} · ${timeframe}` : role) : null;
---

<section class="case-study-hero">
	<img src={logo} alt={logoAlt} class="logo" style={`height: ${logoHeight}px`} />
	<h1 class="headline">{headline}</h1>
	{subtitle && <p class="subtitle">{subtitle}</p>}
	<div class="tags">
		{tags.map((tag) => (
			<span class="tag">{tag}</span>
		))}
	</div>
	{description && <p class="description">{description}</p>}
</section>

<style>
	.case-study-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		padding-top: 48px;
		padding-bottom: 48px;
	}

	.logo {
		width: auto;
		object-fit: contain;
	}

	.headline {
		margin: 0;
		font-family: 'Work Sans', sans-serif;
		font-size: 28px;
		font-weight: 500;
		line-height: 1.2;
		color: #1a1a1a;
		text-align: center;
	}

	.subtitle {
		margin: 0;
		font-family: 'Work Sans', sans-serif;
		font-size: 14px;
		font-weight: 400;
		line-height: 1.4;
		color: #868686;
		text-align: center;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin: 0;
	}

	.tag {
		padding: 6px 12px;
		background-color: #f5f5f5;
		border-radius: 9999px;
		font-family: 'Work Sans', sans-serif;
		font-size: 14px;
		font-weight: 400;
		color: #4a4a4a;
	}

	.description {
		margin: 0;
		max-width: 640px;
		font-family: 'Work Sans', sans-serif;
		font-size: 18px;
		font-weight: 400;
		line-height: 1.6;
		color: #4a4a4a;
	}
</style>
