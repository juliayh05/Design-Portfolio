---
import Layout from '../../layouts/Layout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';

const lingotuneCard = {
	href: '/work/lingotune',
	logoSrc: '/images/lingotune/logo.png',
	companyName: 'Lingotune',
	headline: 'Redesigning song navigation for easier discoverability',
	tags: ['Product Design', 'Mobile', 'EdTech'],
	ctaLabel: 'View Lingotune Case Study',
	previewSrc: '/images/lingotune/preview.png',
};

const buildIrlCard = {
	href: '/work/build-irl',
	logoSrc: '/images/build-irl/logo.png',
	companyName: 'Build IRL',
	headline: 'Designing a 0→1 platform for building and running club communities',
	tags: ['Product/UX Design', 'Web/Mobile', 'Social'],
	ctaLabel: 'View Build IRL Case Study',
	previewSrc: '/images/build-irl/preview.png',
};
---

<Layout title="Work — Julia Heo">
	<div class="work-page">
		<header class="work-page__header">
			<h1 class="work-page__heading work-animate work-animate--heading">Work</h1>
			<p class="work-page__subtitle work-animate work-animate--subtitle">A collection of my design work across internships</p>
		</header>

		<div class="work-page__cards">
			<div class="fade-in-on-scroll" style="--fade-delay: 0ms">
				<CaseStudyCard {...lingotuneCard} />
			</div>
			<div class="fade-in-on-scroll" style="--fade-delay: 100ms">
				<CaseStudyCard {...buildIrlCard} />
			</div>
		</div>
	</div>
</Layout>

<style>
	@keyframes work-load-in {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.work-animate {
		animation: work-load-in 800ms ease-out both;
	}

	.work-animate--heading {
		animation-delay: 0ms;
	}

	.work-animate--subtitle {
		animation-delay: 100ms;
	}

	@media (prefers-reduced-motion: reduce) {
		.work-animate {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	.work-page {
		padding: 80px 0 120px;
	}

	.work-page__header {
		margin-bottom: 48px;
	}

	.work-page__heading {
		margin: 0 0 12px;
		font-family: 'Instrument Serif', serif;
		font-size: 44px;
		font-weight: 400;
		line-height: 1.1;
		color: #1a1a1a;
		text-align: center;
	}

	.work-page__subtitle {
		margin: 0;
		font-family: 'Gabarito', sans-serif;
		font-size: 16px;
		font-weight: 400;
		color: #868686;
		text-align: center;
	}

	.work-page__cards {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	@media (max-width: 768px) {
		.work-page {
			padding: 48px 0 80px;
		}

		.work-page__header {
			margin-bottom: 32px;
		}

		.work-page__heading {
			font-size: 40px;
		}

		.work-page__subtitle {
			font-size: 16px;
		}

		.work-page__cards {
			gap: 24px;
		}
	}
</style>