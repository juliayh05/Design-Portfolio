---
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
import CaseStudyHero from '../../components/CaseStudyHero.astro';
import CaseStudySection from '../../components/case-study/CaseStudySection.astro';
import CaseStudySubsection from '../../components/case-study/CaseStudySubsection.astro';

const sections = [
	{ id: 'overview', label: 'Overview' },
	{ id: 'problem', label: 'Problem' },
	{ id: 'constraints', label: 'Constraints' },
	{ id: 'exploration', label: 'Exploration' },
	{ id: 'solution', label: 'Solution' },
	{ id: 'outcome', label: 'Outcome' },
	{ id: 'reflection', label: 'Reflection' },
];
---

<CaseStudyLayout title="Build IRL — Julia Heo" sections={sections}>
	<CaseStudyHero
		logo="/images/build-irl/logo.png"
		logoAlt="Build IRL"
		headline="Designing the first Build IRL experience for both sides of a club community"
		role="UX/Product Design Intern"
		timeframe="January – May 2025"
		tags={['Product Design', 'Web/Mobile', 'Social']}
	/>

	<CaseStudySection id="overview" title="Overview">
		<CaseStudySubsection title="One platform had to work for two very different kinds of people.">
			<p>Build IRL was a 0→1 platform for starting, running, and joining in-person clubs.</p>
			<p>At first, that sounded like one product problem. Research revealed two: builders were overwhelmed by the work happening behind their communities, while potential joiners struggled to tell whether a club would actually feel right for them.</p>
			<p>Over 10 weeks, my team and I helped define the MVP around both sides of that experience. We moved from interviews and product framing into core user flows, mid-fidelity exploration, and high-fidelity web and mobile prototypes.</p>
		</CaseStudySubsection>
	</CaseStudySection>

	<div class="dual-hero">
		<div class="dual-hero__side">
			<img src="/images/build-irl/builder-paths.jpg" alt="Builder choosing how to start their club page: create from scratch, generate with AI, or import from Instagram" class="case-study-image case-study-image--phone" />
			<p class="dual-hero__caption"> Builder: Less time managing</p>
		</div>
		<div class="dual-hero__divider">
			<span></span>
		</div>
		<div class="dual-hero__side">
			<img src="/images/build-irl/joiner-profile.jpg" alt="Joiner viewing the Cat Cafes club profile with photos, interest tags, and an about section" class="case-study-image case-study-image--phone" />
			<p class="dual-hero__caption">Joiner: More confidence joining</p>
		</div>
	</div>
	<p class="dual-hero__statement"> 💡 One community. Two very different needs.</p>

	<CaseStudySection id="problem" title="Problem">
		<CaseStudySubsection title="Running a club was fragmented. Joining one was a leap of faith.">
			<p>Through more than 10 interviews with club builders and joiners, two problems kept surfacing on opposite sides of the experience.</p>

			<div class="research-split">
				<div class="research-col">
					<p class="research-col__label">Builders</p>
					<span class="research-col__badge">Too many moving pieces</span>

					<div class="tool-cluster">
						<svg class="tool-cluster__lines" viewBox="0 0 400 210" preserveAspectRatio="none" aria-hidden="true">
							<path d="M100,55 C130,80 150,60 175,72" />
							<path d="M215,60 C240,50 255,75 270,68" />
							<path d="M120,80 C110,105 90,120 110,145" />
							<path d="M180,90 C190,115 175,130 195,150" />
							<path d="M250,85 C260,110 245,125 260,148" />
							<path d="M150,160 C180,175 210,170 235,160" />
						</svg>

						<div class="tool-card tool-card--1">
							<span class="tool-card__icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
							</span>
							<span class="tool-card__label">Planning</span>
						</div>
						<div class="tool-card tool-card--2">
							<span class="tool-card__icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
							</span>
							<span class="tool-card__label">RSVPs</span>
						</div>
						<div class="tool-card tool-card--3">
							<span class="tool-card__icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
							</span>
							<span class="tool-card__label">Promotion</span>
						</div>
						<div class="tool-card tool-card--4">
							<span class="tool-card__icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
							</span>
							<span class="tool-card__label">Communication</span>
						</div>
						<div class="tool-card tool-card--5">
							<span class="tool-card__icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
							</span>
							<span class="tool-card__label">Logistics</span>
						</div>
					</div>
				</div>
				<div class="research-col">
					<p class="research-col__label">Joiners</p>
					<span class="research-col__badge">Not enough to go on</span>

					<div class="research-col__listing">
						<span class="listing-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
						</span>
						<div>
							<p class="mini-listing__name">Club name</p>
							<p class="mini-listing__meta">Description · Date · Location</p>
						</div>
					</div>
					<div class="research-col__questions">
						<span class="question-chip"><span class="question-chip__mark">?</span>Who usually comes?</span>
						<span class="question-chip"><span class="question-chip__mark">?</span>What does it feel like?</span>
						<span class="question-chip"><span class="question-chip__mark">?</span>Would I fit in?</span>
						<span class="question-chip"><span class="question-chip__mark">?</span>Is it active?</span>
					</div>
				</div>
			</div>


			<div class="observation">
				<span class="observation__label">01</span>
				<div class="observation__body">
					<p class="observation__title">Builders were doing too much across too many tools.</p>
					<p class="observation__text">Planning, RSVPs, promotion, communication, and logistics were often spread across several platforms. Running the club started to feel like managing software instead of building community.</p>
				</div>
			</div>

			<div class="observation">
				<span class="observation__label">02</span>
				<div class="observation__body">
					<p class="observation__title">Joiners didn't have enough context to commit.</p>
					<p class="observation__text">A club name, description, and event details could explain what was happening, but not what the community actually felt like. Potential joiners still had to guess whether they'd fit in.</p>
				</div>
			</div>

			<blockquote class="pull-quote3">💡 Builders needed less work. Joiners needed more confidence.</blockquote>

			<div class="image-pair">
				<img src="/images/build-irl/affinitymap.png" alt="Affinity map synthesizing interview findings" class="case-study-image" />
				<img src="/images/build-irl/archetypes.png" alt="Four user archetypes split across builders and joiners" class="case-study-image case-study-image--wide" />
			</div>
		</CaseStudySubsection>
		<br>

		<CaseStudySubsection title="The challenge wasn't adding features. It was deciding what the MVP actually needed to solve.">
			<p>Build IRL could have gone in a lot of directions: events, messaging, discovery, club management, profiles, onboarding, creation tools.</p>
			<p>But trying to solve everything at once would just recreate the same complexity we were trying to reduce. So we narrowed the product around two questions:</p>

			<div class="feature-funnel">
				<div class="feature-funnel__cloud">
					<span class="scatter-chip">Events</span>
					<span class="scatter-chip">Messaging</span>
					<span class="scatter-chip">Discovery</span>
					<span class="scatter-chip">Profiles</span>
					<span class="scatter-chip">Club management</span>
					<span class="scatter-chip">Onboarding</span>
					<span class="scatter-chip">Creation tools</span>
					<span class="scatter-chip">Community content</span>
				</div>
				<div class="feature-funnel__arrow">↓</div>
			</div>

			<blockquote class="pull-quote"><b>01</b> Does this remove meaningful work for builders?</blockquote>
			<blockquote class="pull-quote"><b>02</b> Does this give joiners enough context to feel confident joining?</blockquote>
		</CaseStudySubsection>
	</CaseStudySection>

	<CaseStudySection id="constraints" title="Constraints">
		<CaseStudySubsection title="The product was still moving while we were designing it">
			<div class="constraint-grid constraint-grid--3col">
				<div class="constraint-card">
					<p class="constraint-card__label">⏳ 10-week timeline</p>
					<p class="constraint-card__text">We had a limited window to research, define the core experience, and move key flows into high fidelity.</p>
				</div>
				<div class="constraint-card">
					<p class="constraint-card__label">📝 0→1 product, shifting scope</p>
					<p class="constraint-card__text">There wasn't an established product to optimize. Features, flows, and priorities were still being worked out as we designed.</p>
				</div>
				<div class="constraint-card">
					<p class="constraint-card__label">💻 📱 Web + mobile</p>
					<p class="constraint-card__text">We explored the experience across both platforms, then had to rethink parts of the work as the product moved toward a more mobile-first direction.</p>
				</div>
			</div>
		</CaseStudySubsection>
	</CaseStudySection>

	<CaseStudySection id="exploration" title="Exploration">
		<CaseStudySubsection title="Before designing screens, we had to understand how the two sides connected">
			<p>A club created by a builder eventually became the experience evaluated by a joiner. That meant decisions on one side of the product affected what was possible on the other.</p>
			<p>We mapped the core journeys in mid-fidelity first, using them to work through hierarchy, dependencies, and scope before committing to polished UI.</p>
			<p>This stage was intentionally loose. As we reviewed the product with stakeholders, screens moved, flows changed, and some ideas were reworked once we could see the experience end to end.</p>

			<img src="/images/build-irl/journey-map.png" alt="Early flow mapping for the builder and joiner journeys" class="case-study-image case-study-image--wide diagram-full" />
			<img src="/images/build-irl/mid-fi.png" alt="Mid-fi flows for both sides of the product" class="case-study-image diagram-full" />
			<blockquote class="pull-quote3">💡 Mid-fi gave us room to make those changes quickly without getting too attached to polished UI too early.</blockquote>
		</CaseStudySubsection>
	</CaseStudySection>

	<CaseStudySection id="solution" title="Solution">
		<CaseStudySubsection title="Help joiners understand the club before asking them to join.">
			<p>The joiner experience couldn't just answer what, where, and when. Research showed people were also trying to figure out whether the community actually felt like a fit.</p>
			<p>So, we brought more of the club's personality and context forward — things like interests, visuals, and community details — before committing.</p>

			<div class="reveal-diagram">
				<div class="reveal-diagram__before">
					<p class="reveal-diagram__tag">Before</p>
					<div class="wireframe-card">
						<div class="wireframe-card__image">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="16.5" cy="7.5" r="1.8" />
								<path d="M3 17.5l5.5-6 3.5 3.5 4-4.5 5 5.5" />
							</svg>
						</div>
						<p class="wireframe-card__title">Club name</p>
						<p class="wireframe-card__meta">What · Where · When</p>
						<div class="wireframe-card__lines">
							<span class="wireframe-card__line" style="width: 100%;"></span>
							<span class="wireframe-card__line" style="width: 90%;"></span>
							<span class="wireframe-card__line" style="width: 62%;"></span>
						</div>
						<div class="wireframe-card__divider"></div>
						<div class="wireframe-card__pills">
							<span></span>
							<span></span>
							<span></span>
						</div>
					</div>
					<p class="reveal-diagram__caption">A basic listing</p>
				</div>

				<div class="reveal-diagram__arrow">
					<span class="reveal-diagram__arrow-label">From logistics to a sense of fit</span>
					<span class="reveal-diagram__arrow-glyph" aria-hidden="true">→</span>
				</div>

				<div class="reveal-diagram__after">
					<p class="reveal-diagram__tag reveal-diagram__tag--accent">Build IRL</p>
					<div class="reveal-diagram__phone">
						<img src="/images/build-irl/joiner-profile.jpg" alt="Annotated Build IRL club profile showing club imagery, interest tags, and an about section" class="case-study-image case-study-image--phone" />
						<div class="reveal-diagram__callout reveal-diagram__callout--1">
							<span class="reveal-diagram__dot" aria-hidden="true"></span>
							<span class="reveal-diagram__line" aria-hidden="true"></span>
							<span class="reveal-diagram__text"><b>Club imagery</b>See the community</span>
						</div>
						<div class="reveal-diagram__callout reveal-diagram__callout--2">
							<span class="reveal-diagram__dot" aria-hidden="true"></span>
							<span class="reveal-diagram__line" aria-hidden="true"></span>
							<span class="reveal-diagram__text"><b>Interest tags</b>Find shared interests</span>
						</div>
						<div class="reveal-diagram__callout reveal-diagram__callout--3">
							<span class="reveal-diagram__dot" aria-hidden="true"></span>
							<span class="reveal-diagram__line" aria-hidden="true"></span>
							<span class="reveal-diagram__text"><b>About section</b>Get a feel for the culture</span>
						</div>
					</div>
					<p class="reveal-diagram__caption reveal-diagram__caption--after">A community-rich profile</p>
				</div>
			</div>

			<blockquote class="pull-quote reveal-diagram-quote">💡 The goal wasn't to add more information. It was to surface the information that actually helped someone decide: Can I see myself here?</blockquote>

			<div class="decision-flow">
				<div class="decision-flow__step">
					<img src="/images/build-irl/joiner-profile.jpg" alt="Joiner discovers the club" class="case-study-image case-study-image--phone" />
					<p class="decision-flow__label"><b>01</b> Discover</p>
				</div>
				<div class="decision-flow__step">
					<img src="/images/build-irl/joiner-story.jpg" alt="Joiner reads about the community's story and values" class="case-study-image case-study-image--phone" />
					<p class="decision-flow__label"><b>02</b> Understand</p>
				</div>
				<div class="decision-flow__step">
					<img src="/images/build-irl/joiner-confirm.jpg" alt="Joiner's application is confirmed" class="case-study-image case-study-image--phone" />
					<p class="decision-flow__label"><b>03</b> Join</p>
				</div>
			</div>
		</CaseStudySubsection>

		<CaseStudySubsection title="Don't make every builder start from the same place.">
			<p>Builders came into Build IRL with very different levels of momentum. Some already knew exactly what they wanted to create. Others had an idea but needed help shaping it. And existing communities might already have a visual identity somewhere else.</p>
			<p>Instead of forcing everyone through one setup path, we designed three ways builders could begin:</p>

			<div class="cue-grid">
				<div>
					<video src="/images/build-irl/video-2.mp4" autoplay loop muted playsinline class="cue-grid__video"></video>
					<p class="cue__label">✏️ Create from scratch</p>
					<p class="cue__text">Control without unnecessary guidance, for builders who already had a clear vision.</p>
				</div>
				<div>
					<video src="/images/build-irl/video-3.mp4" autoplay loop muted playsinline class="cue-grid__video"></video>
					<p class="cue__label">✨ Generate with AI</p>
					<p class="cue__text">A starting point instead of a blank page — for builders with an idea but not the words for it.</p>
				</div>
				<div>
					<video src="/images/build-irl/video-4.mp4" autoplay loop muted playsinline class="cue-grid__video"></video>
					<p class="cue__label">📸 Import from Instagram</p>
					<p class="cue__text">Carries existing branding forward, for communities that shouldn't have to rebuild their identity.</p>
				</div>
			</div>

			<blockquote class="pull-quote">💡 We adapted onboarding to different starting points instead of treating every builder like a blank slate.</blockquote>
		</CaseStudySubsection>

		<CaseStudySubsection title="What builders created became what joiners used to decide.">
			<p>The builder and joiner experiences weren't separate design problems. The information a builder added during creation became the context a joiner relied on later.</p>
			<p>A club's visuals, interests, description, and activities had to be easy for builders to provide and meaningful for joiners to evaluate.</p>

			<div class="ecosystem">
				<img src="/images/build-irl/builder-scratch.jpg" alt="Builder reviewing club name, tagline, description, cover photo, and tags" class="case-study-image case-study-image--phone" />
				<span class="ecosystem__arrow">→</span>
				<img src="/images/build-irl/joiner-profile.jpg" alt="Joiner viewing those same details on the club profile" class="case-study-image case-study-image--phone" />
			</div>

		</CaseStudySubsection>
	</CaseStudySection>

	<CaseStudySection id="outcome" title="Outcome">
		<CaseStudySubsection title="From an early concept to a conference-ready prototype.">
			<p>Over 10 weeks, we defined and prototyped the core Build IRL experience across both sides of the community. The final direction was approved by the team and presented at a conference, where it received positive feedback.</p>

			

			<p>Since I didn't have access to long-term product metrics, the next things I'd want to understand are below — this is a measurement plan, not measured results.</p>

			<div class="metrics-groups">
				<div class="metrics-group">
					<p class="metrics-group__label">Builder experience</p>
					<blockquote class="pull-quote3"><b>Creation completion rate</b>: Do builders finish creating a club once they start?</blockquote>
					<blockquote class="pull-quote3"><b>Time to publish</b>: How quickly can a builder get a club live?</blockquote>
					<blockquote class="pull-quote3"><b>Builder drop-off</b>: Where do builders lose momentum?</blockquote>
				</div>
				<div class="metrics-group">
					<p class="metrics-group__label">Joiner experience</p>
					<blockquote class="pull-quote3"><b>Club profile engagement</b>: Do people explore the details that support a decision?</blockquote>
					<blockquote class="pull-quote3"><b>Join conversion</b>: Does richer club context help people feel confident joining?</blockquote>
					<blockquote class="pull-quote3"><b>Joiner drop-off</b>: Where do joiners lose momentum?</blockquote>
				</div>
			</div>
		</CaseStudySubsection>
	</CaseStudySection>

	<CaseStudySection id="reflection" title="Reflection">
		<CaseStudySubsection title="I became more comfortable designing before everything was figured out.">
			<p>Build IRL changed frequently while we were working on it. Flows I thought were settled would shift after a stakeholder conversation or once we saw the entire experience together.</p>
			<p>Earlier in the project, those changes could feel like moving backward. Over time, I started to see them differently. In a 0→1 product, changing a design because the reasoning evolved isn't lost work — it's part of defining the product.</p>
			<p>I left the project more comfortable changing direction when the evidence changed, even when that meant letting go of something I had already designed.</p>

		</CaseStudySubsection>
	</CaseStudySection>

</CaseStudyLayout>

<style>
	.dual-hero {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 32px;
		max-width: 976px;
		margin: 8px auto 0;
		padding: 0 20px;
	}

	.dual-hero__side {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.dual-hero__eyebrow {
		margin: 0 0 4px;
		font-family: 'Gabarito', sans-serif;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: #4483F0;
	}

	.dual-hero__caption {
		margin: 10px 0 0;
		font-family: 'Gabarito', sans-serif;
		font-size: 14px;
		font-weight: 500;
		color: #4a4a4a;
	}

	.dual-hero__divider {
		display: flex;
		align-items: center;
		height: 300px;
	}

	.dual-hero__divider span {
		display: block;
		width: 1px;
		height: 100%;
		background: #EDEDED;
	}

	.dual-hero__statement {
		margin: 20px auto 60px;
		max-width: 480px;
		font-family: 'Gabarito', sans-serif;
		font-size: 16px;
		color: #868686;
		text-align: center;
	}

	.image-pair {
		display: flex;
		gap: 56px;
		align-items: center;
		margin-top: 24px;
	}

	.image-pair :global(.case-study-image),
	.image-pair :global(.case-study-image--wide) {
		max-width: none;
		width: 100%;
		min-width: 0;
		flex: 1 1 0;
		margin: 0;
	}

	.diagram-full {
		max-width: none;
		width: 100%;
	}

	.research-split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: start;
		gap: 24px;
		margin-top: 24px;
	}

	.research-col {
		padding: 14px 20px 20px;
		background-color: #FCFCFC;
		border: 1px solid #EDEDED;
		border-radius: 14px;
	}

	.research-col .research-col__label {
		margin: 0 0 10px;
		font-family: 'Gabarito', sans-serif;
		font-size: 18px;
		font-weight: 600;
		color: #1a1a1a;
	}

	.research-col__badge {
		display: inline-block;
		margin: 0 0 20px;
		padding: 3px 10px;
		background-color: #E4F0FF;
		border-radius: 9999px;
		font-family: 'Gabarito', sans-serif;
		font-size: 13px;
		font-weight: 600;
		color: #4483F0;
	}

	.scatter-chip {
		display: inline-block;
		padding: 6px 12px;
		background-color: #F5F5F5;
		border-radius: 9999px;
		font-family: 'Gabarito', sans-serif;
		font-size: 13px;
		font-weight: 400;
		color: #4a4a4a;
	}

	.scatter-chip--2 { transform: rotate(-2deg); }
	.scatter-chip--3 { transform: rotate(1.5deg); }
	.scatter-chip--4 { transform: rotate(-1deg); }
	.scatter-chip--5 { transform: rotate(2deg); }

	.tool-cluster {
		position: relative;
		height: 175px;
		margin: 0 -4px 0;
	}

