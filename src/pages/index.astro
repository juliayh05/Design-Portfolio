---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';

const lingotuneCard = {
	href: '/work/lingotune',
	title: 'Song Navigation Redesign',
	description: 'Redesigning song navigation for easier discoverability',
	previewSrc: '/images/lingotune/preview.png',
	icon: '/images/lingotune/logo.png',
};

const buildIrlCard = {
	href: '/work/build-irl',
	title: '0 to 1 MVP Design',
	description: 'Designing an MVP from 0-to-1 for club communities',
	previewSrc: '/images/build-irl/preview.png',
	icon: '/images/build-irl/logo.png',
};

const netflixCard = {
	href: '/projects/netflix',
	title: 'Netflix Concept Redesign',
	description: 'Helping Netflix users spend less time choosing and more time watching',
	previewSrc: '/images/netflix/solonetflixmood.png',
	icon: '/images/netflix.png',
	dark: true,
};
---

<Layout>
	<Hero>
		<CaseStudyCard slot="work" {...lingotuneCard} />
		<CaseStudyCard slot="work" {...buildIrlCard} />

		<CaseStudyCard slot="projects" {...netflixCard} />

	</Hero>
</Layout>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
	const panels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');
	const tabBar = document.querySelector<HTMLElement>('.tabs');
	const validTabs = new Set(['work', 'projects']);

	const activateTab = (target: string, { scroll = false }: { scroll?: boolean } = {}) => {
		if (!validTabs.has(target)) return;

		tabs.forEach((item) => {
			const isActive = item.dataset.tab === target;
			item.classList.toggle('tab--active', isActive);
			item.setAttribute('aria-selected', isActive ? 'true' : 'false');
		});

		panels.forEach((panel) => {
			panel.hidden = panel.dataset.tabPanel !== target;
		});

		if (scroll) {
			tabBar?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}

		requestAnimationFrame(() => {
			const visiblePanel = document.querySelector<HTMLElement>(`[data-tab-panel="${target}"]:not([hidden])`);
			if (!visiblePanel) return;
			window.refreshFadeInOnScroll?.(visiblePanel, { replay: true });
		});
	};

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const target = tab.dataset.tab;
			if (!target) return;
			activateTab(target);
		});
	});

	const handleHash = () => {
		const hash = window.location.hash.slice(1);
		if (validTabs.has(hash)) {
			activateTab(hash, { scroll: true });
		}
	};

	handleHash();
	window.addEventListener('hashchange', handleHash);
</script>

<style>
	.projects-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 40px;
		justify-items: center;
	}

</style>
