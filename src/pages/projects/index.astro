---
import Layout from '../../layouts/Layout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';

const netflixCard = {
	href: '/projects/netflix',
	title: 'Netflix Concept Redesign',
	description: 'Helping Netflix users spend less time choosing and more time watching',
	previewSrc: '/images/netflix/solonetflixmood.png',
	icon: '/images/netflix.png',
	dark: true,
};
---

<Layout title="Projects — Julia Heo">
	<div class="work-page">
		<header class="work-page__header">
			<h1 class="work-page__heading work-animate work-animate--heading">Projects</h1>
			<p class="work-page__subtitle work-animate work-animate--subtitle">Side projects, experiments, and things I've built outside of work</p>
		</header>

		<div class="work-page__cards">
			<div class="work-page__card-item fade-in-on-scroll" style="--fade-delay: 0ms">
				<CaseStudyCard {...netflixCard} />
			</div>
			
		</div>
	</div>
</Layout>

<style>
	@keyframes work-load-in {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.work-animate {
		animation: work-load-in 800ms ease-out both;
	}

	.work-animate--heading {
		animation-delay: 0ms;
	}

	.work-animate--subtitle {
		animation-delay: 100ms;
	}

	@media (prefers-reduced-motion: reduce) {
		.work-animate {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	.work-page {
		padding: 80px 0 120px;
	}

	.work-page__header {
		margin-bottom: 48px;
	}

	.work-page__heading {
		margin: 0 0 12px;
		font-family: 'Instrument Serif', serif;
		font-size: 44px;
		font-weight: 400;
		line-height: 1.1;
		color: #1a1a1a;
		text-align: center;
	}

	.work-page__subtitle {
		margin: 0;
		font-family: 'Gabarito', sans-serif;
		font-size: 16px;
		font-weight: 400;
		color: #868686;
		text-align: center;
	}

	.work-page__cards {
		display: flex;
		flex-wrap: wrap;
		gap: 48px 40px;
	}

	.work-page__card-item {
		flex: 0 1 calc(50% - 20px);
		min-width: 280px;
	}

	@media (max-width: 768px) {
		.work-page {
			padding: 48px 0 80px;
		}

		.work-page__header {
			margin-bottom: 32px;
		}

		.work-page__heading {
			font-size: 40px;
		}

		.work-page__subtitle {
			font-size: 16px;
		}

		.work-page__cards {
			gap: 32px;
		}

		.work-page__card-item {
			flex: 1 1 100%;
		}
	}
</style>
